{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/presentation",
      "destination": "/presentation.html"
    },
    {
      "source": "/presentation.html",
      "destination": "/presentation.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
